# Copy to .env (never commit .env). Every key, token and repository identifier used by the pipeline is read from the environment.

# --- provider keys ---
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
HF_TOKEN=
HF_WRITE_TOKEN=

# --- locations ---
CSW_DATA_ROOT=.
CSW_ENV_FILE=
CSW_PAPER_DIR=
CSW_WORK=
CSW_PYTHON=
CSW_COMET_PYTHON=
CSW_QE_LOG=
CSW_RETOK_DIR=
CSW_TOKENIZER_JSON=
CSW_TOKENIZER_SNAPSHOTS=
CSW_HF_CACHE=

# --- Hub repository identifiers (owner/name); intentionally not stored in the source tree ---
CSW_MODEL_REPO=
CSW_DATASET_REPO=
CSW_DATASET_NAME=
CSW_BASE_MODEL=
CSW_REPLAY_SFT_REPO=
CSW_REPLAY_BENCH_REPO=
CSW_REPLAY_WEAK_REPO=
CSW_REPLAY_CLEAN_REPO=
CSW_ENGLISH_SOURCE_ORG=
CSW_ENGLISH_SOURCE_SUFFIX=
CSW_ENGLISH_SOURCES_FILE=

# --- generator models used by the data-generation pipeline ---
CSW_GEN_MODEL=
CSW_ADJ_MODEL=
